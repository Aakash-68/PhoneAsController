<?xml version="1.0" encoding="utf-8"?>
<!-- Strings, colours and themes for PhoneAsController. -->
<resources>
    <string name="app_name">PhoneAsController</string>
    <color name="icon_bg">#EEECE7</color>
    <color name="bg">#0E0F11</color>
    <color name="fg">#E9EAEE</color>
    <color name="accent">#C8714F</color>

    <style name="ConnectTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/fg</item>
    </style>

    <style name="ControllerTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
