<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window when double-clicked; stdin/stdout still work when the server spawns it -->
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework ships with Windows 10/11, so no runtime is bundled: smaller download, less memory. -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <AssemblyName>PhoneController</AssemblyName>
    <RootNamespace>PhoneController</RootNamespace>
    <Product>PhoneController</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <!-- Wi-Fi Direct hotspot API (WinRT). Only metadata: the real code is part of Windows. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
  </ItemGroup>

</Project>
